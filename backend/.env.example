# ============================================================
# AI-Assisted Criminal Investigation & Intelligence Platform
# Phase 1.1 - Environment Configuration
# Copy to .env and adjust values. NEVER commit the real .env.
# ============================================================

# --- Application ---
PROJECT_NAME=AI-Assisted Criminal Investigation & Intelligence Platform
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=investigation
POSTGRES_PASSWORD=investigation
POSTGRES_DB=investigation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://investigation:investigation@localhost:5432/investigation

# --- JWT Authentication ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_64_bytes_minimum_aaaaaaaaaaaaaaaaaaaaaaaa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Bootstrap Administrator (seeded by scripts/init_db.py) ---
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.in
ADMIN_BADGE=ADM-0001
ADMIN_PASSWORD=ChangeMe_Str0ng_Admin_2026!

# --- Evidence Storage (Phase 1.1) ---
# storage backend: "local" (dev, filesystem) or "minio" (production, S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=evidence-vault
MINIO_SECURE=false

# --- Antivirus (Phase 1.1) ---
# Set CLAMAV_ENABLED=true to require a live ClamAV daemon on CLAMAV_HOST:CLAMAV_PORT
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310